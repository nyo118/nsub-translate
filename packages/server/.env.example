# Copy to packages/server/.env (never commit .env). Backend-only secrets.
# ASR_PROVIDER=sensevoice          # sensevoice | mock
# TRANSLATION_PROVIDER=hy-mt2      # default engine: hy-mt2 | gemini | llm | google | mock | none
# TRANSLATION_THREADS=3
# ASR_THREADS=2

# Gemini via Google AI Studio (free tier, no billing needed) — https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite          # keep a fast non-thinking model; 31B / thinking models take 20 s per line

# Any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama, LM Studio on another machine, …)
# LLM_BASE_URL=http://192.168.50.2:1234        # bare host → /v1 is appended automatically
# LLM_API_KEY=                                 # LM Studio API token / provider key
# LLM_MODEL=hy-mt2-1.8b                        # model id as the server names it

# Google Cloud Translation (needs a billing account)
# GOOGLE_TRANSLATE_API_KEY=
